# P.A.T.C.H. AI (FastAPI) - complete configuration contract
# Copy to .env.local for local development. Never commit real values.
# The AI service never receives Cloudflare R2 credentials. It reads originals through short-lived URLs issued by Web.

# Runtime and service identity
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
SERVICE_NAME=patch-ai

# Private Web-to-AI boundary - must equal web/AI_SERVICE_SHARED_SECRET
AI_SERVICE_SHARED_SECRET=replace-with-the-same-long-random-secret-used-by-web
AI_SERVICE_REQUEST_MAX_SKEW_SECONDS=300
AI_SERVICE_REQUEST_TIMEOUT_SECONDS=90

# Pre-signed source-file download policy (Cloudflare R2 URL is supplied per ingestion request)
SOURCE_DOWNLOAD_TIMEOUT_SECONDS=30
SOURCE_DOWNLOAD_MAX_BYTES=52428800
SOURCE_URL_ALLOWED_HOSTS=replace-with-account-id.r2.cloudflarestorage.com
SUPPORTED_DOCUMENT_MIME_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Local OCR executable. Blank discovers PATH or standard Windows install locations.
OCR_TESSERACT_CMD=
OCR_LANGUAGES=eng
OCR_RENDER_DPI=200
OCR_MAX_IMAGE_PIXELS=30000000
OCR_TIMEOUT_SECONDS=15

# OpenAI through LangChain
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_ANSWER_MODEL=gpt-5.6-terra
OPENAI_ANSWER_REASONING_EFFORT=medium
OPENAI_ROUTING_MODEL=gpt-5.6-luna
OPENAI_ROUTING_REASONING_EFFORT=low
OPENAI_COMPLEX_REASONING_MODEL=gpt-5.6-terra
OPENAI_COMPLEX_REASONING_EFFORT=high
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Pinecone - one index; explicit namespace separates text/profile vectors by environment.
# Visual-description vectors use their own explicit namespace, never derived from APP_ENV.
# Pinecone is never the system of record.
PINECONE_API_KEY=replace-with-pinecone-api-key
PINECONE_INDEX_NAME=patch
PINECONE_NAMESPACE=development
PINECONE_VISUAL_NAMESPACE=visual-development

# Phase 7 opt-in visual Chat and bounded detection/search; see Setup_Guide.md.
VISUAL_RETRIEVAL_ENABLED=false
VISUAL_CANDIDATE_PAGES=12
VISUAL_REGIONS_PER_PAGE=4
VISUAL_PREVIEW_DPI=72
VISUAL_CANDIDATE_COUNT=20
VISUAL_GATE_LIMIT=6
VISUAL_FINAL_LIMIT=3
VISUAL_SEARCH_TIMEOUT_SECONDS=15

# Ingestion and retrieval defaults - tune only through an approved configuration change
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=120
ENTITY_PROFILE_CANDIDATE_COUNT=8
ENTITY_ROUTING_ENABLED=false
ENTITY_ROUTING_MAX_SELECTED_SCOPES=5
ENTITY_ROUTING_MIN_SCORE=0.45
STRUCTURAL_FALLBACK_MAX_DOCUMENT_VERSIONS=200
RETRIEVAL_CANDIDATE_COUNT=20
RERANK_RESULT_COUNT=8
MAX_ANSWER_CITATIONS=8
MAINTENANCE_LOG_INDEXING_ENABLED=false

# Service observability - Sentry and OTLP are optional
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
OTEL_SERVICE_NAME=patch-ai
OTEL_EXPORTER_OTLP_ENDPOINT=
