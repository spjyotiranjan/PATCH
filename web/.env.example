# P.A.T.C.H. Web (Next.js) - complete configuration contract
# Copy to .env.local for local development. Never commit real values.
# Add a variable only when it is first added to this template and documented in web/docs/Environment.md.

# Runtime and public application identity
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=P.A.T.C.H.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
WEB_HOST=127.0.0.1
PORT=3000

# Authentication - AUTH_SECRET must be a high-entropy value (for example: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=false

# MongoDB - MongoDB is the system of record
MONGODB_URI=mongodb+srv://replace-with-hosted-mongodb-connection-string/
MONGODB_DB_NAME=patch
# Optional process-local SRV/TXT DNS resolvers, comma-separated IPs; blank uses system DNS.
MONGODB_DNS_SERVERS=
# 0 = automatic, 4 = IPv4, 6 = IPv6. Does not replace SRV/TXT DNS resolution.
MONGODB_ADDRESS_FAMILY=0

# Internal Web-to-AI service boundary - server-side only; never prefix with NEXT_PUBLIC_
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_SHARED_SECRET=replace-with-the-same-long-random-secret-used-by-ai
AI_SERVICE_TIMEOUT_MS=120000
AI_SERVICE_RETRY_COUNT=1
BACKEND_WORKER_SECRET=replace-with-a-separate-long-random-worker-secret
WORKER_BASE_URL=http://localhost:3000

# Cloudflare R2 - canonical original-document storage; S3-compatible private bucket
# R2 endpoint format: https://<account-id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=patch-documents-development
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_DOCUMENT_KEY_PREFIX=documents
R2_PRESIGNED_URL_TTL_SECONDS=900

# Document upload policy - R2 objects remain private; the Web service issues short-lived URLs to AI
MAX_DOCUMENT_UPLOAD_BYTES=52428800
ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Browser/API controls
# Browser and WebSocket Origin must exactly match AUTH_URL; no wildcard CORS.
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60

# Observability - Sentry is optional; leave SENTRY_DSN empty when disabled
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
OTEL_SERVICE_NAME=patch-web
OTEL_EXPORTER_OTLP_ENDPOINT=
